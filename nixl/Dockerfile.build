# syntax=docker/dockerfile:1
# Build environment for NIXL, UCX and NIXLBench.
# Override CUDA_VERSION and UBUNTU_VERSION at build time, for example:
#   docker build --build-arg CUDA_VERSION=12.8.1 --build-arg UBUNTU_VERSION=22.04 .
ARG CUDA_VERSION=13.0.3
ARG UBUNTU_VERSION=24.04
FROM nvcr.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:/opt/venv/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/compat:${LD_LIBRARY_PATH} \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    VIRTUAL_ENV=/opt/venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        flex \
        git \
        hwloc \
        ibverbs-providers \
        ibverbs-utils \
        libaio-dev \
        libcurl4-openssl-dev \
        libgflags-dev \
        libhwloc-dev \
        libibumad-dev \
        libibverbs-dev \
        libnl-3-dev \
        libnl-route-3-dev \
        libnuma-dev \
        librdmacm-dev \
        libssl-dev \
        libtool \
        libtool-bin \
        libxml2-dev \
        libzstd-dev \
        ninja-build \
        patchelf \
        pkg-config \
        python3-dev \
        python3-pip \
        python3-venv \
        rdma-core \
        rsync \
        tar \
        unzip \
        uuid-dev \
        wget \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir \
        meson \
        ninja \
        pybind11 \
        patchelf \
        PyYAML \
        click \
        tabulate

RUN install -d -o "${BUILDER_UID}" -g "${BUILDER_GID}" /workspace /workspace/projects/nixl-ucx /opt/nixl-build

COPY --chmod=0755 scripts/build-in-pod.sh /usr/local/bin/build-in-pod

ENV HOME=/workspace
WORKDIR /workspace/projects/nixl-ucx
USER ${BUILDER_UID}:${BUILDER_GID}
CMD ["sleep", "infinity"]
